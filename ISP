========== ISP ==========

root/toor

hostnamectl hostname ISP
exec bash

# === ВНЕШНИЙ интерфейс (магистраль) ===
echo 'TYPE=eth' > /etc/net/ifaces/ens18/options
echo 'dhcp' > /etc/net/ifaces/ens18/ipv4address

# === ВНУТРЕННИЕ интерфейсы ===
mkdir -p /etc/net/ifaces/ens{19,20}
echo 'TYPE=eth' | tee /etc/net/ifaces/ens{19,20}/options

echo '172.16.10.1/28' > /etc/net/ifaces/ens19/ipv4address   # к HQ-RTR
echo '172.16.20.1/28' > /etc/net/ifaces/ens20/ipv4address   # к BR-RTR

# === NAT (уже было) ===
apt-get update && apt-get install nftables -y
cat << EOF > /etc/nftables/nftables.nft
#!/usr/sbin/nft -f
flush ruleset
table ip nat {
 chain postrouting {
  type nat hook postrouting priority srcnat;
  oifname "ens18" masquerade
 }
}
EOF

# === Маршрутизация + запуск ===
sed -i 's/net.ipv4.ip_forward = 0/net.ipv4.ip_forward = 1/' /etc/net/sysctl.conf
systemctl enable --now nftables
systemctl restart network

# === ПРОВЕРКА ===
ip -br a
ip r
ping -c 2 ya.ru
