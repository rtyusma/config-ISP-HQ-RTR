    container_name: site
    image: site:latest
    restart: always
    ports: 
      - "8081:8000"
    environment: 
      DB_HOST: db
      DB_PORT: 3306
      DB_NAME: testdb1
      DB_USER: test1
      DB_PASS: P@ssw0rd
      DB_TYPE: maria
