========== HQ-RTR ==========

hostnamectl hostname hq-rtr.au-team.irpo
exec bash

mkdir -p /etc/net/ifaces/{ens19,vlan{111,211,811},gre1}
echo 'TYPE=eth' | tee /etc/net/ifaces/ens{18,19}/options

# === к ISP ===
echo '172.16.10.2/28' > /etc/net/ifaces/ens18/ipv4address
echo 'default via 172.16.10.1' > /etc/net/ifaces/ens18/ipv4route

# === VLAN (router-on-a-stick) ===
echo $'111\n211\n811' | xargs -i bash -c 'echo -e "TYPE=vlan\nHOST=ens19\nVID={}" > /etc/net/ifaces/vlan{}/options'

echo '192.168.111.1/27' > /etc/net/ifaces/vlan111/ipv4address   # HQ-SRV (≤32)
echo '192.168.211.1/28' > /etc/net/ifaces/vlan211/ipv4address   # HQ-CLI (≥16)
echo '192.168.811.1/29' > /etc/net/ifaces/vlan811/ipv4address   # management (≤8)

# === GRE ===
cat << EOF > /etc/net/ifaces/gre1/options
TYPE=iptun
TUNTYPE=gre
TUNLOCAL=172.16.10.2
TUNREMOTE=172.16.20.2
TUNTTL=64
EOF
echo "10.10.10.1/30" > /etc/net/ifaces/gre1/ipv4address

# === IP Forward + NAT ===
sed -i 's/net.ipv4.ip_forward = 0/net.ipv4.ip_forward = 1/' /etc/net/sysctl.conf
cat << EOF > /etc/nftables/nftables.nft
#!/usr/sbin/nft -f
flush ruleset
table ip nat { chain postrouting { type nat hook postrouting priority srcnat; oifname "ens18" masquerade } }
EOF

# === Запуск ===
apt-get install frr dnsmasq nftables -y
systemctl enable --now nftables
systemctl restart network

# === OSPF (ТОЛЬКО на GRE!) ===
sed -i 's/ospfd=no/ospfd=yes/' /etc/frr/daemons
cat <<'EOF' > /etc/frr/frr.conf
interface gre1
 ip ospf area 0
 ip ospf authentication
 ip ospf authentication-key P@ssw0rd
 no ip ospf passive
exit
!
router ospf
 passive-interface default
exit
EOF
systemctl restart frr

# === DHCP (vlan211) ===
cat <<'EOF' > /etc/dnsmasq.conf
port=0
interface=vlan211
dhcp-authoritative
dhcp-range=192.168.211.2,192.168.211.14,255.255.255.240,6h
dhcp-option=3,192.168.211.1
dhcp-option=6,192.168.111.2
EOF
systemctl enable --now dnsmasq

# === net_admin + timezone ===
useradd net_admin && echo "net_admin:P@ssw0rd" | chpasswd
usermod -aG wheel net_admin
echo "WHEEL_USERS ALL=(ALL:ALL) NOPASSWD: ALL" > /etc/sudoers.d/net_admin
timedatectl set-timezone Europe/Moscow
