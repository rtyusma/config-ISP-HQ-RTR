# ====================== HQ-RTR ======================
nft add rule nat prerouting iif "ens18" tcp dport 8081 dnat to 192.168.1.10:8081
nft add rule nat prerouting iif "ens18" tcp dport 2011 dnat to 192.168.1.10:2011

nft list ruleset > /etc/nftables/nftables.nft
systemctl restart nftables
nft list ruleset

# ====================== BR-RTR ======================
nft add rule nat prerouting iif "ens18" tcp dport 8081 dnat to 192.168.3.10:8081
nft add rule nat prerouting iif "ens18" tcp dport 2011 dnat to 192.168.3.10:2011

nft list ruleset > /etc/nftables/nftables.nft
systemctl restart nftables
nft list ruleset

